# HTTPS gateway base URL or complete /v1/responses endpoint.
# Native Responses streaming and tool support required; no Chat fallback.
GROUND_URL=https://YOUR_COMPANY_GATEWAY/v1
GROUND_API_KEY=

# Optional: JSON argv array; leave unset to discover Node + npm-global Codex.
# CODEX_BINARY=["C:/Program Files/nodejs/node.exe","C:/Users/you/AppData/Roaming/npm/node_modules/@openai/codex/bin/codex.js"]

# Optional: Codex PowerShell runtime directory allowed read-only by the sandbox.
# CODEX_RUNTIME_DEP=C:/Users/you/.cache/codex-runtimes/codex-primary-runtime/dependencies/native/powershell
